generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  createdAt      DateTime        @default(now())
  accounts       Account[]
  follow_ups     follow_ups[]
  reports        reports[]
  research_jobs  research_jobs[]
  sessions       Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

model follow_ups {
  id          String    @id @db.Uuid
  report_id   String    @db.Uuid
  user_id     String    @db.Uuid
  question    String
  answer      String?
  turn_number Int
  created_at  DateTime? @db.Timestamptz(6)
  reports     reports   @relation(fields: [report_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model reports {
  id                  String           @id @db.Uuid
  job_id              String           @db.Uuid
  user_id             String           @db.Uuid
  report_markdown     String?
  raw_context         Json?
  suggested_followups Json?
  sentiment_positive  Float?
  sentiment_neutral   Float?
  sentiment_negative  Float?
  reddit_volume       Int?
  source_count        Int?
  overall_sentiment   sentiment_label?
  created_at          DateTime?        @db.Timestamptz(6)
  follow_ups          follow_ups[]
  research_jobs       research_jobs    @relation(fields: [job_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users               User             @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model research_jobs {
  id           String     @id @db.Uuid
  user_id      String     @db.Uuid
  query        String
  status       job_status
  created_at   DateTime?  @db.Timestamptz(6)
  completed_at DateTime?  @db.Timestamptz(6)
  reports      reports[]
  users        User       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

enum job_status {
  pending
  running
  done
  failed
}

enum sentiment_label {
  Positive
  Mixed
  Negative
}
