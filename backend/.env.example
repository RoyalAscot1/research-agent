DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/lens
GEMINI_API_KEY=
TAVILY_API_KEY=
YOUTUBE_API_KEY=
FRONTEND_URL=http://localhost:3000
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Per-user API rate limiting. Defaults to true; set false only for local load testing.
RATE_LIMIT_ENABLED=true
# Observability. LOG_LEVEL gates structured-log verbosity (DEBUG/INFO/WARNING/...);
# ENVIRONMENT tags logs + Sentry events. SENTRY_DSN is optional — error alerting is a
# no-op unless set (leave blank for local/dev). Set it in Render to activate in prod.
LOG_LEVEL=INFO
ENVIRONMENT=development
SENTRY_DSN=
